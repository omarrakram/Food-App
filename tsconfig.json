{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // `scripts/` and `supabase/functions/` are Node and Deno programs. They are
  // type-checked by their own configs, because React Native module resolution
  // cannot resolve Node built-ins or Deno's URL imports.
  "exclude": ["node_modules", "dist", "coverage", "scripts", "supabase/functions"]
}
