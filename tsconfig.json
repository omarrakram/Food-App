{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    // `src/features/ai/schema.ts` is loaded by both Metro and the Deno runtime
    // that executes the edge functions. Deno requires explicit file extensions
    // on relative imports, so that module writes them; this flag lets the app's
    // type-checker accept the same source.
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // `scripts/` and `supabase/functions/` are Node and Deno programs. They are
  // type-checked by their own configs, because React Native module resolution
  // cannot resolve Node built-ins or Deno's URL imports.
  "exclude": ["node_modules", "dist", "coverage", "scripts", "supabase/functions", "nothing-personal"]
}
