# ---------------------------------------------------------------------------
# Akla — environment variables
#
# Copy to `.env.local` (git-ignored) and fill in.
#
#   EXPO_PUBLIC_*  => bundled into the CLIENT app. NEVER put a secret here.
#   everything else => server-side only (Supabase Edge Function secrets / CI).
# ---------------------------------------------------------------------------

# === CLIENT (safe to ship in the app bundle) ===============================

# Supabase project URL. Settings -> API -> Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase publishable / anon key. Safe in the client ONLY because Row Level
# Security is enabled on every table. Settings -> API -> anon public.
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# App environment: development | preview | production
EXPO_PUBLIC_APP_ENV=development

# Default market. Drives currency, locale and price-estimate lookups.
EXPO_PUBLIC_DEFAULT_COUNTRY=EG
EXPO_PUBLIC_DEFAULT_CURRENCY=EGP

# Feature flags (true/false). Grocery ordering stays off until a real
# provider agreement + credentials exist.
EXPO_PUBLIC_ENABLE_GROCERY_ORDERING=false
EXPO_PUBLIC_ENABLE_SOCIAL_AUTH=false

# OAuth client IDs are public identifiers, not secrets. Leave blank to hide
# the corresponding social sign-in button.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# === SERVER-ONLY (Supabase Edge Function secrets) ==========================
# Set with:  supabase secrets set KEY=value
# NEVER prefix these with EXPO_PUBLIC_ and never import them from src/.

# Anthropic API key used by the `ai-suggest` / `ai-interpret` edge functions.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# Optional. Defaults to claude-opus-5.
ANTHROPIC_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max. Defaults to medium,
# because a user is waiting on this request and the output schema is strict.
ANTHROPIC_EFFORT=medium

# Injected automatically by the Supabase Functions runtime — only needed when
# running `supabase functions serve` locally.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=YOUR_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_LOCAL_SERVICE_ROLE_KEY

# Per-user AI rate limits enforced inside the edge functions.
AI_RATE_LIMIT_PER_HOUR=30
AI_RATE_LIMIT_PER_DAY=150

# Comma-separated origins allowed to call the edge functions. The mobile app
# sends no Origin header and is unaffected; set this for web deployments.
ALLOWED_ORIGINS=

# === GROCERY PROVIDERS (not required for V1) ===============================
# V1 ships the `mock` provider only. Each real provider needs a commercial
# agreement before credentials can be issued. See ARCHITECTURE.md.
GROCERY_PROVIDER=mock
CARREFOUR_EG_API_KEY=
TALABAT_MART_API_KEY=
BREADFAST_API_KEY=
INSTASHOP_API_KEY=

# === EAS / build ===========================================================
# Created by `eas init`; not a secret.
EAS_PROJECT_ID=
