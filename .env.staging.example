# STAGING ONLY. Copy to `.env.staging`, which is git-ignored, and fill it in.
#
# NOTHING IN THIS FILE IS A PRODUCTION VALUE, and nothing here may be reused
# from production. A staging deploy that shares a key with production is not a
# staging deploy — it is production with a different URL.
#
# The two halves are deliberately separated:
#
#   EXPO_PUBLIC_*  is inlined into the app bundle and is therefore PUBLIC.
#                  Only the project URL and the publishable key belong here.
#   everything else is used by `scripts/deploy-staging.sh` and by Supabase Edge
#                  Function secrets. NONE of it may ever reach the bundle;
#                  `scripts/__tests__/payment-secrets.test.ts` is the gate.

# --- The staging Supabase project -------------------------------------------
# Dashboard -> Project Settings -> General
SUPABASE_STAGING_PROJECT_REF=
# Dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_STAGING_DB_URL=
# Dashboard -> Account -> Access Tokens. Used by the CLI to deploy.
SUPABASE_ACCESS_TOKEN=
# Dashboard -> Project Settings -> API
SUPABASE_STAGING_URL=
SUPABASE_STAGING_PUBLISHABLE_KEY=
SUPABASE_STAGING_SERVICE_ROLE_KEY=

# --- The app, pointed at staging --------------------------------------------
EXPO_PUBLIC_APP_ENV=preview
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_ENABLE_GROCERY_ORDERING=true
# OFF in staging. Staging exists to exercise a real database merchant; the
# bundled fixture would give the app something to fall back to and hide a
# failure of the thing being tested.
EXPO_PUBLIC_DEMO_MERCHANT=false
EXPO_PUBLIC_DEMO_MODE=false

# --- Where the app lives, and who may call the functions ---------------------
#
# TWO VALUES THAT LOOK ALIKE AND ARE NOT THE SAME KIND OF THING. Neither is a
# secret. Both are read by deployed Edge Functions, and both fail SILENTLY when
# they are wrong — which is why they are required rather than optional.
#
# For the GitHub Pages preview, which is a PROJECT site served under /Food-App,
# the correct pair is:
#
#   APP_BASE_URL=https://omarrakram.github.io/Food-App
#   ALLOWED_ORIGINS=https://omarrakram.github.io
#
# They differ because one is a place and the other is a header value.

# THE BASE URL THE STAGING WEB BUILD IS SERVED FROM. A PATH IS FINE and is
# often required: a GitHub Pages project site lives under the repository name.
# No trailing slash, so the route appended to it reads the same every time.
#
#   e.g. https://omarrakram.github.io/Food-App     (Pages project site)
#        https://akalt-staging.pages.dev           (a site at the domain root)
#        http://localhost:8081                     (a dev server)
#
# `payments-begin` builds the customer's return destination from it:
# `<APP_BASE_URL>/payment/<orderId>`, sent to Paymob as `redirection_url`. So
# the first example produces
# `https://omarrakram.github.io/Food-App/payment/<orderId>`. It is also where
# the demo simulator page lives.
#
# THAT REDIRECT IS UX AND NOTHING ELSE. It is where the customer's browser
# lands; it is never proof that anything was paid. The signed callback to
# `payments-webhook` is the only thing that settles an order. Getting this
# wrong sends a paying customer to the wrong page — it cannot take or lose
# money.
#
# LEAVING IT BLANK IS WORSE THAN SETTING IT WRONG, because it is quiet:
# `payments-begin` then falls back to the caller's `Origin` header and finally
# to a hard-coded production URL, so a staging payment can send the customer
# into the production app with a staging order id in the path.
APP_BASE_URL=

# Comma-separated BROWSER ORIGINS allowed to call the Edge Functions.
#
# An `Origin` header is `scheme://host[:port]` and NEVER carries a path or a
# trailing slash — so neither may an entry here, whatever APP_BASE_URL looks
# like. `_shared/http.ts` compares the two as exact strings, and
# `https://x.dev/` never equals `https://x.dev`.
#
#   e.g. https://omarrakram.github.io                        (for the Pages
#                                                             example above —
#                                                             note: no /Food-App)
#        https://akalt-staging.pages.dev,http://localhost:8081
#
# The ORIGIN OF APP_BASE_URL must be one of these; the deploy script and
# `verify-staging.mjs` both refuse otherwise, because the page the customer is
# returned to is the page that then calls the functions. Add anything else you
# open the staging build from.
#
# REQUIRED FOR A HOSTED WEB BUILD. In a deployment, `_shared/http.ts` refuses
# every browser origin when this is unset — the localhost fallback applies only
# when there is no allow-list AND no deployment id, i.e. genuinely a
# developer's machine. The native app sends no Origin header and is unaffected;
# so is `payments-webhook`, because Paymob is server-to-server.
ALLOWED_ORIGINS=

# --- Paymob SANDBOX ----------------------------------------------------------
# SANDBOX / TEST credentials only. A live key in a staging environment is the
# single most expensive mistake available here, and `verify-staging.mjs`
# refuses to pass if it can tell the base URL is a live one.
#
# THERE IS NO REDIRECT VARIABLE HERE, deliberately. This file used to carry a
# `PAYMOB_REDIRECTION_URL` that no code has ever read: the redirect is derived
# from APP_BASE_URL above, per order, by `payments-begin`. Adding one back
# would configure nothing.
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=

# --- Anthropic (the AI functions) -------------------------------------------
# A staging key, with its own budget.
ANTHROPIC_API_KEY=
