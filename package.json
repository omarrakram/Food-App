{
  "name": "akla",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test -- --ci",
    "export:web": "expo export --platform web",
    "prebuild": "expo prebuild --clean",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:types": "supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "db:types:check": "node --experimental-strip-types --no-warnings scripts/check-db-types.ts",
    "db:types:from-url": "supabase gen types typescript --db-url \"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/akla_test}\" > src/lib/supabase/database.types.ts",
    "fn:serve": "supabase functions serve --env-file supabase/functions/.env",
    "fn:deploy": "supabase functions deploy",
    "eas:build:preview": "eas build --profile preview",
    "eas:build:prod": "eas build --profile production",
    "ingredients:import": "node --experimental-strip-types --no-warnings scripts/import-ingredients.ts",
    "prices:import": "node --experimental-strip-types --no-warnings scripts/import-prices.ts",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.ts",
    "fn:check": "deno check --min-dep-age 0 --config supabase/functions/deno.json supabase/functions/ai-suggest/index.ts supabase/functions/ai-interpret/index.ts",
    "fn:test": "deno test --min-dep-age 0 --allow-env --config supabase/functions/deno.json supabase/functions/",
    "db:test": "./scripts/db-test.sh",
    "smoke:web": "node scripts/smoke-web.mjs"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/",
      "/dist/",
      "/supabase/functions/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/app/**",
      "!src/**/__tests__/**",
      "!src/**/__mocks__/**"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@supabase/.*|isows))"
    ],
    "resolver": "react-native-worklets/jest/resolver.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "expo": "~57.0.21",
    "expo-apple-authentication": "~57.0.1",
    "expo-auth-session": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-keep-awake": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-network": "~57.0.1",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-updates": "~57.0.21",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "deno": "^2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.5",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  }
}
