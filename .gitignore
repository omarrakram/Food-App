# dependencies
node_modules/

# Expo
.expo/
dist/
.smoke/
.walk/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# env
.env
.env.local
.env.*.local
.env.development
.env.production

# supabase local
supabase/.temp/
supabase/.branches/
supabase/functions/.env
# Per-function lockfiles: deno writes one next to any deno.json it is
# pointed at. The functions share supabase/functions/deno.lock (the npm
# scripts pass it with --lock), and shipping a second, possibly newer
# lock format inside a function directory is exactly what the hosted
# bundler would read on deploy.
supabase/functions/*/deno.lock

# testing
coverage/

# misc
*.log
.idea/

# EAS / store credentials — never commit these
google-play-service-account.json
*.keystore
credentials.json
